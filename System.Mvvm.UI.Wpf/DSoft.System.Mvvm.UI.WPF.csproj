<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net462;net10.0-windows7.0;net10.0-windows10.0.18362.0;net11.0-windows7.0;net11.0-windows10.0.18362.0;</TargetFrameworks>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<PackageId>DSoft.System.Mvvm.UI.WPF</PackageId>
		<Description>WPF platform support for DSoft.System.Mvvm.UI for .NET Framework 4.6.2 and .NET 10 and .NET 11+</Description>
		<PackageReleaseNotes>Added .NET 11 support alongside .NET 10 and updated packages.</PackageReleaseNotes>
		<PackageTags>WPF MVVM NetCore</PackageTags>
		<AssemblyName>System.Mvvm.UI.WPF</AssemblyName>
		<Product>$(AssemblyName) ($(TargetFramework))</Product>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<RootNamespace>System.Mvvm</RootNamespace>
		<UseWPF>true</UseWPF>
		<DefineConstants>$(DefineConstants);WPF</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<None Include="readme.md" Pack="true" PackagePath="\" />
		<ProjectReference Include="..\System.Mvvm.Ui\DSoft.System.Mvvm.UI.csproj" />
		<ProjectReference Include="..\System.Mvvm\DSoft.System.Mvvm.csproj" />
	</ItemGroup>

	<ItemGroup Condition=" $(TargetFramework.StartsWith('net11.0'))">
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup Condition=" !$(TargetFramework.StartsWith('net11.0'))">
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
	</ItemGroup>
</Project>